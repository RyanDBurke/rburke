{
    "$schema":  "node_modules/wrangler/config-schema.json",
    "name":  "rburke",
    "compatibility_date":  "2026-10-01",
    "assets":  {
                   "directory":  "./dist",
                   "binding":  "ASSETS",
                   "run_worker_first":  [
                                            "/api/*",
                                            "/admin/*"
                                        ]
               },
    "main":  "worker/index.js",
    "d1_databases":  [
                         {
                             "database_name":  "notes",
                             "migrations_dir":  "migrations",
                             "database_id":  "9ea11872-aef3-46a8-b2f3-39a9b4085eed",
                             "binding":  "DB"
                         }
                     ],
    "ai":  {
               "binding":  "AI"
           },
    "ratelimits":  [
                       {
                           "namespace_id":  "1001",
                           "simple":  {
                                          "limit":  5,
                                          "period":  60
                                      },
                           "name":  "NOTES_LIMITER"
                       }
                   ],
    "vars":  {
                 "AI_ENABLED":  "false",
                 "HOLD_ALL":  "false",
                 "ACCESS_ISSUER":  "https://REPLACE.cloudflareaccess.com",
                 "ACCESS_AUD":  "REPLACE",
                 "OWNER_EMAIL":  "REPLACE"
             }
}
